// Processing Load - Medium:
process {
cpus = 12
memory = 36.GB
}
executor {
queueSize = 5
}

conda.enabled = true
conda.channels = 'conda-forge'
conda.createOptions = '--override-channels'

//
// If using slurm uncomment below (medium):
// process {
// executor = 'slurm'
// cpus = 6
// memory = 36.GB
// }
// executor {
// queueSize = 5
// }
